# Copy to .env and fill in real values. Never commit .env.

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
DEVISE_JWT_SECRET_KEY=

# ── Active Record encryption (PII columns) ───────────────────────────────────
# Generate with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where OAuth callbacks and email-confirmation links redirect to.
FRONTEND_URL=http://localhost:5173

# Local development: enables mock checkout and defers email confirmation.
# Ignored in production. Set false to test email confirmation locally.
LOCAL_PREVIEW=true
# Comma-separated allowed CORS origins (production).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Mailer ───────────────────────────────────────────────────────────────────
MAILER_FROM=noreply@example.com

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Inert dev placeholders — the app boots and every non-OAuth route works
# (signup, login, JWT auth, all API endpoints). Clicking "Sign in with Google"
# redirects to Google, which rejects the fake client with an invalid_client
# error page; nothing crashes on our side. To test the flow end-to-end, create
# a real OAuth 2.0 Client ID in Google Cloud Console → APIs & Services →
# Credentials and paste the values here.
GOOGLE_CLIENT_ID=dev-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev-google-client-secret

# ── Apple Sign In ────────────────────────────────────────────────────────────
# Inert dev placeholders — same behavior as Google above: everything works
# except the actual Apple handshake, which Apple rejects. Real values come
# from the Apple Developer portal (paid account required).
APPLE_CLIENT_ID=com.example.eosvenues.dev
APPLE_TEAM_ID=DEV0000000
APPLE_KEY_ID=DEVKEY0000
# PEM contents of the .p8 key (newlines escaped as \n), or place the file at
# config/apple_auth_key.p8
APPLE_PRIVATE_KEY=
